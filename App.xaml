<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:YoutubeShortsEditorMobile"
             xmlns:converters="clr-namespace:YoutubeShortsEditorMobile.Converters"
             x:Class="YoutubeShortsEditorMobile.App">
    <Application.Resources>
        <ResourceDictionary>
            <converters:DownloadStateToColorConverter x:Key="StateToColorConverter" />
            <converters:BoolToMuteIconConverter x:Key="MuteIconConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
